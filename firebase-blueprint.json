{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile linked to an authenticated school persona",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "schoolId": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "SchoolTenant": {
      "title": "SchoolTenant",
      "description": "Multi-tenant educational institution organization (Phase 5 School Registration)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "logoUrl": { "type": "string" },
        "slogan": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "establishedYear": { "type": "integer" },
        "schoolType": { "type": "string" },
        "academicSession": { "type": "string" },
        "currency": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "timezone": { "type": "string" },
        "primaryColorHex": { "type": "string" },
        "secondaryColorHex": { "type": "string" },
        "adminUid": { "type": "string" },
        "status": { "type": "string" },
        "subscriptionPlan": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "code",
        "address",
        "phone",
        "email",
        "establishedYear",
        "schoolType",
        "academicSession",
        "currency",
        "timezone",
        "status"
      ]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Complete student record for Student Information System (SIS)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string" },
        "rollNumber": { "type": "string" },
        "admissionNumber": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "section": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "status": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianRelationship": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "guardianEmail": { "type": "string" },
        "address": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "medicalNotes": { "type": "string" },
        "enrollmentDate": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "schoolId",
        "firstName",
        "lastName",
        "fullName",
        "rollNumber",
        "admissionNumber",
        "gradeLevel",
        "section",
        "status"
      ]
    },
    "TeacherProfile": {
      "title": "TeacherProfile",
      "description": "Complete faculty and staff member record (Phase 9 Teacher & Staff Management)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "employeeId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string" },
        "designation": { "type": "string" },
        "department": { "type": "string" },
        "primarySubject": { "type": "string" },
        "additionalSubjects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "qualification": { "type": "string" },
        "joiningDate": { "type": "string" },
        "experienceYears": { "type": "integer" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "address": { "type": "string" },
        "assignedClassId": { "type": "string" },
        "assignedSectionId": { "type": "string" },
        "isClassTeacher": { "type": "boolean" },
        "bloodGroup": { "type": "string" },
        "salaryTier": { "type": "string" },
        "status": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "schoolId",
        "employeeId",
        "firstName",
        "lastName",
        "fullName",
        "designation",
        "department",
        "primarySubject",
        "qualification",
        "email",
        "phone",
        "status"
      ]
    },
    "AcademicClass": {
      "title": "AcademicClass",
      "description": "Academic grade class container (Phase 10 Class, Section & Subject Allocation Engine)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "numericGrade": { "type": "integer" },
        "stream": { "type": "string" },
        "sectionsCount": { "type": "integer" },
        "totalStudents": { "type": "integer" },
        "academicYear": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId", "name", "code", "numericGrade"]
    },
    "ClassSection": {
      "title": "ClassSection",
      "description": "Classroom section with room assignment and student capacity (Phase 10)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "name": { "type": "string" },
        "roomNumber": { "type": "string" },
        "capacity": { "type": "integer" },
        "currentEnrollment": { "type": "integer" },
        "classTeacherId": { "type": "string" },
        "classTeacherName": { "type": "string" },
        "academicYear": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId", "classId", "name", "roomNumber", "capacity"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily roll call register and audit log container (Phase 11 Attendance Tracking & Audit System)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "date": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "sectionId": { "type": "string" },
        "sectionName": { "type": "string" },
        "markedById": { "type": "string" },
        "markedByName": { "type": "string" },
        "isFinalized": { "type": "boolean" },
        "totalStudents": { "type": "integer" },
        "presentCount": { "type": "integer" },
        "absentCount": { "type": "integer" },
        "lateCount": { "type": "integer" },
        "excusedCount": { "type": "integer" },
        "attendancePercentage": { "type": "number" },
        "entries": {
          "type": "array",
          "items": { "type": "object" }
        },
        "auditTrail": {
          "type": "array",
          "items": { "type": "object" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId", "date", "classId", "sectionId", "markedById"]
    },
    "FeeInvoice": {
      "title": "FeeInvoice",
      "description": "Institutional fee invoice and payment ledger container (Phase 12 Fee Structure & Invoicing Engine)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "rollNumber": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "section": { "type": "string" },
        "academicTerm": { "type": "string" },
        "dueDate": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "type": "object" }
        },
        "totalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "fineAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "status": { "type": "string" },
        "transactions": {
          "type": "array",
          "items": { "type": "object" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId", "invoiceNumber", "studentName", "dueDate", "totalAmount", "status"]
    },
    "ExamSchedule": {
      "title": "ExamSchedule",
      "description": "Examination timetable and scheduling series for students and classes (Phase 13)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "title": { "type": "string" },
        "examType": { "type": "string" },
        "academicSession": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string" },
        "papers": {
          "type": "array",
          "items": { "type": "object" }
        },
        "totalPapers": { "type": "integer" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "schoolId", "title", "examType", "gradeLevel", "startDate", "endDate", "status"]
    },
    "StudentResult": {
      "title": "StudentResult",
      "description": "Student academic evaluation transcript and GPA grading report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "examId": { "type": "string" },
        "examTitle": { "type": "string" },
        "academicSession": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "rollNumber": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "section": { "type": "string" },
        "subjectScores": {
          "type": "array",
          "items": { "type": "object" }
        },
        "totalMarksObtained": { "type": "number" },
        "totalMaxMarks": { "type": "number" },
        "percentage": { "type": "number" },
        "overallGrade": { "type": "string" },
        "gpa": { "type": "number" },
        "classRank": { "type": "integer" },
        "status": { "type": "string" },
        "remarks": { "type": "string" },
        "publishedAt": { "type": "integer" }
      },
      "required": ["id", "schoolId", "examId", "studentId", "studentName", "gradeLevel", "overallGrade", "gpa", "status"]
    },
    "SchoolNotice": {
      "title": "SchoolNotice",
      "description": "Circular announcements and targeted broadcast notices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "targetAudience": { "type": "string" },
        "targetGrade": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "attachmentCount": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "expiresAt": { "type": "integer" }
      },
      "required": ["id", "schoolId", "title", "content", "category", "priority", "targetAudience", "authorName"]
    },
    "TenantEntity": {
      "title": "TenantEntity",
      "description": "General representation of a tenant-scoped record in any of the 15 isolated subcollections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "schoolId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles indexed by authentication UID"
    },
    "/schools/{schoolId}": {
      "schema": "SchoolTenant",
      "description": "School institutions containing full 12-field registration metadata"
    },
    "/schools/{schoolId}/students/{studentId}": {
      "schema": "StudentProfile",
      "description": "Subcollection 1: Student Information System (SIS) enrollment records"
    },
    "/schools/{schoolId}/teachers/{teacherId}": {
      "schema": "TeacherProfile",
      "description": "Subcollection 2: Teacher faculty and staff records"
    },
    "/schools/{schoolId}/parents/{parentId}": {
      "schema": "TenantEntity",
      "description": "Subcollection 3: Parent guardian profiles"
    },
    "/schools/{schoolId}/classes/{classId}": {
      "schema": "AcademicClass",
      "description": "Subcollection 4: Academic grade classes"
    },
    "/schools/{schoolId}/sections/{sectionId}": {
      "schema": "ClassSection",
      "description": "Subcollection 5: Class sections"
    },
    "/schools/{schoolId}/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Subcollection 6: Student & teacher daily attendance logs"
    },
    "/schools/{schoolId}/fees/{feeId}": {
      "schema": "FeeInvoice",
      "description": "Subcollection 7: Fee structures, invoices & payment logs"
    },
    "/schools/{schoolId}/exams/{examId}": {
      "schema": "ExamSchedule",
      "description": "Subcollection 8: Exam terms and timetables"
    },
    "/schools/{schoolId}/results/{resultId}": {
      "schema": "StudentResult",
      "description": "Subcollection 9: Academic grade sheets and results"
    },
    "/schools/{schoolId}/notices/{noticeId}": {
      "schema": "SchoolNotice",
      "description": "Subcollection 10: Circulars, announcements & broadcast notices"
    },
    "/schools/{schoolId}/homework/{homeworkId}": {
      "schema": "TenantEntity",
      "description": "Subcollection 11: Daily homework and assignment postings"
    },
    "/schools/{schoolId}/library/{bookId}": {
      "schema": "TenantEntity",
      "description": "Subcollection 12: Library catalog, books & issue records"
    },
    "/schools/{schoolId}/transport/{routeId}": {
      "schema": "TenantEntity",
      "description": "Subcollection 13: Transport routes, buses & driver schedules"
    },
    "/schools/{schoolId}/events/{eventId}": {
      "schema": "TenantEntity",
      "description": "Subcollection 14: School calendar events & sports days"
    },
    "/schools/{schoolId}/documents/{docId}": {
      "schema": "TenantEntity",
      "description": "Subcollection 15: Institutional documents, syllabi & archives"
    }
  }
}
