  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles indexed by authentication UID"
    },
    "/schools/{schoolId}": {
      "schema": "SchoolTenant",
      "description": "School institutions containing full 12-field registration metadata"
    },
    "/schools/{schoolId}/students/{studentId}": {
      "schema": "StudentProfile",
      "description": "Subcollection 1: Student Information System (SIS) enrollment records"
    },
    "/schools/{schoolId}/teachers/{teacherId}": {
      "schema": "TeacherProfile",
      "description": "Subcollection 2: Teacher faculty and staff records"
    },
    "/schools/{schoolId}/parents/{parentId}": {
      "schema": "TenantEntity",
      "description": "Subcollection 3: Parent guardian profiles"
    },
    "/schools/{schoolId}/classes/{classId}": {
      "schema": "AcademicClass",
      "description": "Subcollection 4: Academic grade classes"
    },
    "/schools/{schoolId}/sections/{sectionId}": {
      "schema": "ClassSection",
      "description": "Subcollection 5: Class sections"
    },
    "/schools/{schoolId}/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Subcollection 6: Student & teacher daily attendance logs"
    },
    "/schools/{schoolId}/fees/{feeId}": {
      "schema": "FeeInvoice",
      "description": "Subcollection 7: Fee structures, invoices & payment logs"
    },
    "/schools/{schoolId}/exams/{examId}": {
      "schema": "ExamSchedule",
      "description": "Subcollection 8: Exam terms and timetables"
    },
    "/schools/{schoolId}/results/{resultId}": {
      "schema": "StudentResult",
      "description": "Subcollection 9: Academic grade sheets and results"
    },
    "/schools/{schoolId}/notices/{noticeId}": {
      "schema": "SchoolNotice",
      "description": "Subcollection 10: Circulars, announcements & broadcast notices"
    },
    "/schools/{schoolId}/homework/{homeworkId}": {
      "schema": "HomeworkAssignment",
      "description": "Subcollection 11: Daily homework and assignment postings"
    },
    "/schools/{schoolId}/library/{bookId}": {
      "schema": "LibraryBook",
      "description": "Subcollection 12: Library catalog, books & issue records"
    },
    "/schools/{schoolId}/transport/{routeId}": {
      "schema": "TransportRoute",
      "description": "Subcollection 13: Transport routes, buses & driver schedules"
    },
    "/schools/{schoolId}/events/{eventId}": {
      "schema": "SchoolEvent",
      "description": "Subcollection 14: School calendar events & sports days"
    },
