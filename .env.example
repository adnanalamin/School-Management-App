# EduManage SaaS Environment Configuration
# Configured via AI Studio Secrets and Gradle Secrets Plugin

# Active Environment Profile: DEVELOPMENT | STAGING | PRODUCTION
EDUMANAGE_ENV=DEVELOPMENT

# Multi-Tenant Strict Isolation (true | false)
EDUMANAGE_STRICT_TENANT_ISOLATION=true

# Default Tenant Domain Fallback
EDUMANAGE_DEFAULT_TENANT_ID=sch_oxford_01

# GEMINI_API_KEY: Optional server-side AI integration
# GEMINI_API_KEY=MY_GEMINI_API_KEY
