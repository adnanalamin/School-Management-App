rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Multi-tenant school organizations & 15 subcollections
    match /schools/{schoolId} {
      allow read, create, update, delete: if isAuthenticated();

      // 15 isolated subcollections under each tenant:
      // students, teachers, parents, classes, sections, attendance, fees,
      // exams, results, notices, homework, library, transport, events, documents
      match /{subcollection}/{docId} {
        allow read, write: if isAuthenticated() && subcollection in [
          'students', 'teachers', 'parents', 'classes', 'sections',
          'attendance', 'fees', 'exams', 'results', 'notices',
          'homework', 'library', 'transport', 'events', 'documents'
        ];
      }
    }
  }
}
