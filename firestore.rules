rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    function isAllowedSubcollection(subcollection) {
      return subcollection in [
        'students', 'teachers', 'parents', 'classes', 'sections',
        'attendance', 'fees', 'exams', 'results', 'notices',
        'homework', 'library', 'transport', 'events', 'documents',
        'leaves', 'messages', 'reports', 'branding'
      ];
    }

    function isTenantMatched(schoolId) {
      return request.resource.data.schoolId is string &&
        request.resource.data.schoolId == schoolId;
    }

    // Multi-tenant school organizations & isolated subcollections
    match /schools/{schoolId} {
      allow read, create, update, delete: if isAuthenticated();

      match /{subcollection}/{docId} {
        allow read, delete: if isAuthenticated() && isAllowedSubcollection(subcollection);
        allow create, update: if isAuthenticated() &&
          isAllowedSubcollection(subcollection) &&
          isTenantMatched(schoolId);
      }
    }
  }
}
